# Local containers; replace placeholders before starting.
POSTGRES_DB=tourism_db
POSTGRES_USER=tourism
POSTGRES_PASSWORD=replace_with_local_database_password
AI_SERVICE_API_KEY=replace_with_a_long_random_service_key
MINIO_ROOT_USER=tourism_admin
MINIO_ROOT_PASSWORD=replace_with_a_long_random_minio_password

BACKEND_PORT=3000
FRONTEND_PORT=8080
AI_PORT=9000
QDRANT_PORT=6333
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001
MINIO_REGION=us-east-1
S3_HOTEL_IMAGES_BUCKET=hotel-images

MODEL_NAME=BAAI/bge-m3
AI_BATCH_SIZE=16
AI_MAX_TEXT_LENGTH=8000
AI_TIMEOUT_MS=15000
# Recommendation: content + Bayesian rating; normalized weights are 75% / 25%.
REC_CONTENT_WEIGHT=0.6
REC_QUALITY_WEIGHT=0.2
REC_PRIOR_STRENGTH=50
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TRIP_OSRM_URL=
TRIP_OSRM_DRIVING_URL=
TRIP_OSRM_WALKING_URL=
TRIP_OSRM_CYCLING_URL=

# Fresh installation: dedicated project volumes created by Compose.
AI_VOLUMES_EXTERNAL=false
AI_DATA_VOLUME_NAME=datn_n7_ai_data
QDRANT_DATA_VOLUME_NAME=datn_n7_qdrant_data
HF_CACHE_VOLUME_NAME=datn_n7_hf_cache

# Frontend build settings; use mock for demo data or api for the backend.
VITE_DATA_MODE=api
VITE_API_BASE_URL=/api/v1
