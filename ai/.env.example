# Copy required settings into your existing .env; do not overwrite credentials.
MODEL_NAME=BAAI/bge-m3
BATCH_SIZE=16
MAX_TEXT_LENGTH=8000
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents_bge_m3
# Main factual place collection shared by recommendation and search data.
RECOMMENDATION_COLLECTION=documents_bge_m3
RECOMMENDATION_VECTOR_NAME=dense
RECOMMENDATION_DB_PATH=data/recommendation.sqlite3
# Use behind a trusted backend; this is a service key, not end-user authentication.
RECOMMENDATION_API_KEY=
# Active stage: content + Bayesian rating only. Normalized weights: 75% / 25%.
# Initial heuristic parameters; tune on validation, not test.
REC_CONTENT_WEIGHT=0.6
REC_QUALITY_WEIGHT=0.2
REC_PRIOR_STRENGTH=50
REC_CANDIDATE_LIMIT=500
REC_MAX_INTEREST_GROUPS=3

# Image search: separate CLIP vector space, lazy model load on first image/text query.
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_DIMENSIONS=512
CLIP_DEVICE=cpu
IMAGE_COLLECTION_NAME=tourism_images_clip_v1
IMAGE_VECTOR_NAME=image_dense

# Optional Trip Planner providers. Blank = no external calls.
# Each OSRM server must be prepared for the specified transport profile.
TRIP_OSRM_URL=
TRIP_OSRM_DRIVING_URL=
TRIP_OSRM_WALKING_URL=
TRIP_OSRM_CYCLING_URL=
# Only used when the API request explicitly sets use_llm=true.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LOG_LEVEL=INFO
