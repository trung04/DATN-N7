  "components": {
    "schemas": {
      "RecommendationRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "tfidf",
              "semantic",
              "content_rating",
              "personalized_mmr"
            ],
            "title": "Mode",
            "default": "auto"
          },
          "preference_alpha": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Preference Alpha",
            "default": 0.5
          },
          "mmr_lambda": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Mmr Lambda",
            "default": 0.7
          },
          "mmr_pool_size": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Mmr Pool Size",
            "default": 100
          },
          "refresh_variety": {
            "type": "boolean",
            "title": "Refresh Variety",
            "default": true
          },
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id"
          },
          "include_service_places": {
            "type": "boolean",
            "title": "Include Service Places",
            "default": false
          },
          "preferences": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "type": "array",
                "maxItems": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferences"
          },
          "query": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "city": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "place_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Hotel",
                  "Restaurant",
                  "Attraction"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Place Type"
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "budget": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget"
          },
          "family_friendly": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family Friendly"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "radius_km": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Radius Km"
          },
          "exclude_place_ids": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 500,
            "title": "Exclude Place Ids"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "RecommendationRequest"
      },
      "RecommendationResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "strategy": {
            "type": "string",
            "title": "Strategy"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "retrieval": {
            "type": "string",
            "title": "Retrieval"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "diagnostics": {
            "additionalProperties": true,
            "type": "object",
            "title": "Diagnostics"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "user_id",
          "total",
          "strategy",
          "model_version",
          "retrieval",
          "recommendations"
        ],
        "title": "RecommendationResponse"
      },
      "RecommendationItem": {
        "properties": {
          "place_id": {
            "type": "string",
            "title": "Place Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "place_type": {
            "type": "string",
            "title": "Place Type"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "content_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Score"
          },
          "mmr_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mmr Score"
          },
          "redundancy_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redundancy Score"
          },
          "fresh_since_last": {
            "type": "boolean",
            "title": "Fresh Since Last",
            "default": false
          },
          "quality_score": {
            "type": "number",
            "title": "Quality Score"
          },
          "rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "review_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Count"
          },
          "distance_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Km"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "effective_weights": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Effective Weights"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "place_id",
          "name",
          "place_type",
          "city",
          "score",
          "quality_score",
          "reasons"
        ],
        "title": "RecommendationItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "UserPreferences": {
        "properties": {
          "preferences": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 30,
            "title": "Preferences"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "UserPreferences"
      },
      "InteractionEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Event Id"
          },
          "place_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Place Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "view",
              "favorite",
              "save",
              "rating"
            ],
            "title": "Action"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active"
          },
          "rating": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "place_id",
          "action",
          "occurred_at"
        ],
        "title": "InteractionEvent"
      }
    }
  }
