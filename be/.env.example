NODE_ENV=development
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=tourism_db
POSTGRES_USER=tourism
POSTGRES_PASSWORD=replace_with_team_database_password
POSTGRES_SSL=false
POSTGRES_POOL_SIZE=10
POSTGRES_CONNECT_TIMEOUT_MS=10000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000
CACHE_TTL_MS=60000

# Host development; Compose supplies http://ai:9000 and the root service key.
AI_BASE_URL=http://localhost:9000
AI_API_KEY=replace_with_root_AI_SERVICE_API_KEY
AI_TIMEOUT_MS=15000

# Hotel images: credentials from the root .env MinIO settings.
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY=replace_with_MINIO_ROOT_USER
S3_SECRET_KEY=replace_with_MINIO_ROOT_PASSWORD
S3_HOTEL_IMAGES_BUCKET=hotel-images

FRONTEND_ORIGIN=http://localhost:5173
AUTH_ACCESS_TTL_MS=900000
AUTH_REFRESH_TTL_MS=604800000

# Optional SMTP settings for account verification and password reset OTP.
# These flows return 503 until SMTP_HOST and EMAIL_FROM are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Generate a private random string (at least 32 characters); never commit it.
AUTH_OTP_PEPPER=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Local redirect example: http://localhost:3000/api/v1/auth/google/callback

# SePay API v2 Sandbox. Get the API token and bank account UUID in Test mode.
SEPAY_V2_BASE_URL=https://userapi-sandbox.sepay.vn/v2
SEPAY_V2_API_TOKEN=
SEPAY_V2_BANK_ACCOUNT_XID=
# Required when the selected Sandbox bank account is Vietcombank.
SEPAY_V2_TERMINAL_ID=
# Webhook authentication is separate from the API token. HMAC is recommended.
SEPAY_WEBHOOK_AUTH_TYPE=HMAC_SHA256
SEPAY_WEBHOOK_SECRET=
# Set this instead of SEPAY_WEBHOOK_SECRET only when the SePay webhook uses API Key auth.
SEPAY_WEBHOOK_API_KEY=
