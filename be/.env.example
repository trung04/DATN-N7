NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tourism_db
DATABASE_USER=tourism
DATABASE_PASSWORD=replace_with_team_database_password
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=5000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000
CACHE_TTL_MS=60000

JWT_ACCESS_SECRET=replace_with_secure_random_value
JWT_REFRESH_SECRET=replace_with_another_secure_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Host development; Compose supplies http://ai:9000 and the root service key.
AI_BASE_URL=http://localhost:9000
AI_API_KEY=replace_with_root_AI_SERVICE_API_KEY
AI_TIMEOUT_MS=15000
