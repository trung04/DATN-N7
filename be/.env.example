NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tourism_db
DATABASE_USER=tourism
DATABASE_PASSWORD=replace_with_team_database_password
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=5000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000
CACHE_TTL_MS=60000

# Host development; Compose supplies http://ai:9000 and the root service key.
AI_BASE_URL=http://localhost:9000
AI_API_KEY=replace_with_root_AI_SERVICE_API_KEY
AI_TIMEOUT_MS=15000

FRONTEND_ORIGIN=http://localhost:5173
AUTH_ACCESS_TTL_MS=900000
AUTH_REFRESH_TTL_MS=604800000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Local redirect example: http://localhost:3000/api/v1/auth/google/callback
